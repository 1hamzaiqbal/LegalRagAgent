# Data (downloaded via download_data.py, large)
datasets/
barexam_qa/passages
barexam_qa/qa

# Vector store (rebuilt via load_corpus.py)
chroma_db/

# Environment
.env
venv/
.venv/
__pycache__/

# Lock file (allows flexible dependency resolution per platform)
uv.lock

# Generated artifacts
caches/
case_studies/
logs/
artifacts/
outputs/
.pytest_cache/
.locks/

# Generated reports may be tracked, but row-level/point-level payloads belong
# in the EIT artifact store. Existing July audit JSONL files remain tracked as
# explicit evidence exceptions.
docs/generated/**/*.jsonl

# Editor / OS
.vscode/
*~
*.swp
.DS_Store
.claude/worktrees/

# Scratch / session exports
session_log_latest.txt
docs/session_log_latest.txt
eval/_inspect*.py
eval/_chroma_info.py
.claude/*.lock

# Keep generated/bulk artifacts out of the active repo root. Durable papers and
# bundles belong in the EIT vault or checksummed archive storage, not beside
# source.
/*.pdf
/*.png
/*.tex
/*.zip
/*.sty

# Auto-generated, churns on every machine — regenerated locally, not tracked
current_status.md

# Wiki raw sources (papers/PDFs/repos) — heavy, archived on WUSTL EIT cluster
references/
